# 复制到 /root/hermes-router.env 后填写，并执行 chmod 600。
# 不要把真实 Token/Key 提交到 Git，也不要粘贴到公开聊天。

# 必填：从 Telegram @BotFather 获取
TELEGRAM_BOT_TOKEN=

# 必填：你的 Telegram 数字用户 ID；多个用户用逗号分隔
TELEGRAM_ALLOWED_USERS=

# 可选但推荐：至少配置 OpenRouter，可提高免费模型可用性
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=

# 其他 open-free-router 上游（可选）
NOUS_API_KEY=
POOLSIDE_API_KEY=
SENSENOVA_API_KEY=

# 默认设置
SERVICE_USER=hermesbot
DEFAULT_MODEL=zen/deepseek-v4-flash-free

# Telegram 文本对话不需要浏览器；需要 Hermes 浏览器工具时改成 1
INSTALL_BROWSER=0

# 通常保持默认
HERMES_BRANCH=main
OPEN_FREE_ROUTER_REPO=https://github.com/NoelJudeNoel/open-free-router.git

